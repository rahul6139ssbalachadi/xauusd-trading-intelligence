# Copy this file to .env and update values for your environment
# This file is committed for new user convenience

# API Authentication
API_SECRET_KEY=your-secret-key-here-generate-with-python-secrets-token_urlsafe-48
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database path (SQLite)
DATABASE_PATH=/absolute/path/to/db/trading.db

# Trading configuration
LIVE_TRADING_ENABLED=false
DEFAULT_PAPER_EQUITY=10000
MAX_DAILY_LOSS_PCT=1.0
MAX_WEEKLY_LOSS_PCT=3.0
MAX_POSITION_RISK_PCT=0.25

# MT5 Connection Settings
MT5_MAX_SPREAD_PIPS=5.0
MT5_CONNECTION_TIMEOUT=30

# Debug mode
DEBUG=true
LOG_LEVEL=info