# ============================================================================
# XAUUSD TRADING INTELLIGENCE — DEPLOYMENT ENVIRONMENT
#
# Copy to .env and fill in. NEVER COMMIT .env (it is in .gitignore).
#     cp .env.example .env
#
#   .env.example is the ONLY version of this file that belongs in Git.
#   Every value below is a safe default or empty. Leaving a value empty
#   means "use the built-in default", not "unconfigured and broken".
#
# Two rules that are not negotiable:
#   TRADING_MODE must stay "demo"
#   LIVE_TRADING_ENABLED must stay "false"
# LIVE_TRADING_ENABLED has INVERTED polarity (it matches
# config/settings.toml): true does NOT enable live trading, it BLOCKS
# execution because this build can never trade real money. See
# docs/SECURITY.md.
# ============================================================================


# ---------------------------------------------------------------------------
# MODE / SAFETY — do not change without reading docs/SECURITY.md
# ---------------------------------------------------------------------------
TRADING_MODE=demo
LIVE_TRADING_ENABLED=false

# Permits the execution engine to place orders. Those orders can only ever
# reach an account the gateway has already verified is a DEMO account.
DEMO_EXECUTION_ENABLED=true


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ENVIRONMENT=production          # production | development
API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED in production. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start if this is left at the shipped dev default.
API_SECRET_KEY=

TOKEN_EXPIRE_MINUTES=30

# Comma-separated extra browser origins allowed to call the API.
# EMPTY = same-origin only, which is the correct setting when nginx/Caddy
# serves the dashboard and the API from one host. Do not put "*" here.
ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Leave empty to use the bundled SQLite file at db/trading.db.
#   sqlite:///absolute/path/to/trading.db
# A PostgreSQL URL is recognised but NOT yet implemented for the research
# store; the system stays on SQLite (see docs/DEPLOYMENT_AUDIT.md §7.3).
DATABASE_URL=
TRADING_DB_PATH=db/trading.db
BACKTESTS_DB_PATH=db/backtests.db


# ---------------------------------------------------------------------------
# EXECUTION ADAPTER
#
#   null    no execution at all. Order attempts are REFUSED. This is the
#           default and the correct setting for a Linux server.
#   demo    records trading INTENT to the journal but places no order.
#           Useful for forward-testing the pipeline on a server.
#   mt5     talks to a local MetaTrader5 terminal. WINDOWS ONLY, and
#           disabled unless EXECUTION_ADAPTER is set to mt5 AND
#           MT5_TERMINAL_PATH is provided.
#   bridge  forwards to a Windows bridge over HTTPS. See
#           docs/MT5_ARCHITECTURE.md.
# ---------------------------------------------------------------------------
EXECUTION_ADAPTER=null

# The broker's symbol name for XAUUSD. XM Global: GOLD.i#
BROKER_SYMBOL=GOLD.i#

# Only used by EXECUTION_ADAPTER=mt5 (Windows only)
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Only used by EXECUTION_ADAPTER=bridge
BRIDGE_URL=
BRIDGE_TOKEN=
BRIDGE_TIMEOUT=15


# ---------------------------------------------------------------------------
# NOTIFICATIONS (optional)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
# Path to the Hermes bridge script, read for credentials at call time.
# Only needed if you run notifications on the server; unset is fine.
TELEGRAM_BRIDGE_SCRIPT=D:\rahul_ai\hermes\hermes_telegram_bridge.py


# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text              # text | json
LOG_FILE=                    # empty = stdout only (preferred under Docker)
# /health reports market data as STALE if the newest bar is older than this.
HEALTH_STALE_AFTER_HOURS=48
